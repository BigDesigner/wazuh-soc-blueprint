<group name="soc_blueprint,">

  <!--
  THREAT INTEL GROUP
  Rules in this group are triggered by external threat intelligence matches (e.g., VirusTotal, MISP, URLHaus).
  -->
  <rule id="100001" level="10">
    <field name="integration">virustotal</field>
    <group>threat_intel,malware</group>
    <description>VirusTotal: Positive malware detection match.</description>
    <mitre>
      <id>T1204.002</id>
    </mitre>
  </rule>

  <rule id="100002" level="12">
    <field name="integration">misp</field>
    <group>threat_intel</group>
    <description>MISP: IOC match found in threat intelligence feed.</description>
  </rule>

  <!--
  DNS MONITORING GROUP
  Rules for detecting suspicious DNS activities.
  -->
  <rule id="100100" level="5">
    <if_sid>60000</if_sid>
    <field name="win.eventdata.queryName">\.xyz$|\.top$|\.ru$|\.click$|\.gq$</field>
    <group>dns,suspicious_tld</group>
    <description>DNS query to a suspicious TLD ($(win.eventdata.queryName)).</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

  <!--
  PERSISTENCE MONITORING
  Threshold-based rules for persistence mechanisms.
  -->
  <rule id="100200" level="7">
    <if_sid>61614</if_sid> <!-- Windows: A scheduled task was created -->
    <group>persistence,scheduled_task</group>
    <description>Persistence: A new scheduled task has been created on $(agent.name).</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <rule id="100201" level="10">
    <if_sid>61615</if_sid> <!-- Windows: A service was installed -->
    <group>persistence,service_creation</group>
    <description>Persistence: A new service was installed in the system.</description>
    <mitre>
      <id>T1543.003</id>
    </mitre>
  </rule>

  <!--
  BRUTE FORCE & AUTHENTICATION SPIKES
  Rules to alert on high volume authentication failures.
  -->
  <rule id="100300" level="10" frequency="50" timeframe="300">
    <if_matched_sid>60122</if_matched_sid> <!-- Windows: Logon failure -->
    <same_source_ip />
    <group>authentication_failed,brute_force</group>
    <description>Multiple Windows logon failures from the same source IP (Brute Force attack).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!--
  DEFENSE EVASION & LOG CLEARING (T1070.001)
  Rules to alert on security and event log clearing attempts.
  -->
  <rule id="100500" level="12">
    <if_sid>60000</if_sid>
    <field name="win.system.eventID">^1102$</field>
    <group>defense_evasion,indicator_removal,log_clearing</group>
    <description>Defense Evasion: Windows Security Audit log was cleared on $(win.system.computer) by $(win.eventdata.subjectUserName).</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

  <rule id="100501" level="10">
    <if_sid>60000</if_sid>
    <field name="win.system.eventID">^104$</field>
    <group>defense_evasion,indicator_removal,log_clearing</group>
    <description>Defense Evasion: Windows Event Log file was cleared on $(win.system.computer) (Log Channel: $(win.system.channel)).</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

  <!--
  IMPACT & RANSOMWARE ACTIVITY (T1486 / T1490)
  Rules to detect volume shadow copy deletion and high-frequency mass file modification.
  -->
  <rule id="100600" level="13">
    <if_sid>60000</if_sid>
    <field name="win.system.eventID">^(4688|1)$</field>
    <field name="win.eventdata.commandLine">vssadmin.*delete.*shadows|wmic.*shadowcopy.*delete|wbadmin.*delete.*catalog|bcdedit.*recoveryenabled.*no</field>
    <group>impact,ransomware,defense_evasion</group>
    <description>Ransomware Behavior: Volume shadow copy deletion or recovery inhibition command executed ($(win.eventdata.commandLine)).</description>
    <mitre>
      <id>T1486</id>
      <id>T1490</id>
    </mitre>
  </rule>

  <rule id="100601" level="12" frequency="100" timeframe="60">
    <if_matched_group>syscheck</if_matched_group>
    <same_location />
    <group>impact,ransomware,file_modification</group>
    <description>Potential Ransomware Activity: High-frequency file modifications (100+ changes in 60s) detected by FIM on $(agent.name).</description>
    <mitre>
      <id>T1486</id>
    </mitre>
  </rule>

</group>
